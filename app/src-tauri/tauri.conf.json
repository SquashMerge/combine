{
  "productName": "Combine",
  "identifier": "com.squashmerge.combine",
  "build": { "devUrl": "http://localhost:1420", "frontendDist": "../web/dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Combine", "width": 1200, "height": 800 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"] }
}
