#!/bin/sh
# Every check a change must pass: the feature factory's `verify`, and what to run
# before finishing a change by hand.
#
#   ./tools/verify
#
# It is heavy work (the full test suite, whole-workspace clippy), so it takes the
# shared heavy-run lease itself, at the medium tier, when heavy-medium.sh is
# present (AGENTS.md). Inside a lease (MIMIR_HEAVY_LOCK_HELD set) it runs
# directly, so wrapping it again never nests. Elsewhere, such as CI, it just runs.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

heavy=${COMBINE_HEAVY_SH:-/Users/jcarreira/projects/squashmerge/trellis-evidence/heavy-lock/heavy-medium.sh}
if [ -z "${MIMIR_HEAVY_LOCK_HELD:-}" ] && [ -x "$heavy" ]; then
  exec "$heavy" sh "$0" "$@"
fi

# One build directory per checkout or worktree, never shared (AGENTS.md).
# COMBINE_TARGETS sets the parent; otherwise the shared directory beside the main
# checkout if it exists, else one beside this checkout. Factory sandboxes are named
# after their run, so each still gets its own.
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
  targets=${COMBINE_TARGETS:-}
  if [ -z "$targets" ]; then
    shared="$HOME/projects/squashmerge/combine-targets"
    if [ -d "$shared" ]; then targets=$shared; else targets="$(dirname "$root")/combine-targets"; fi
  fi
  case $root in
    */.factory-sandboxes/*) name="factory-$(basename "$root")" ;;
    *) name=$(basename "$root") ;;
  esac
  CARGO_TARGET_DIR="$targets/$name"
  export CARGO_TARGET_DIR
fi

step() { printf '\n== %s\n' "$*"; }

rustc --version
step "rust: format"
cargo fmt --all --check
step "rust: clippy"
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
step "rust: tests"
cargo test --workspace --all-features --locked

# The shipped build has no test-support: its fake-backend refusal and the binary users
# install are otherwise never compiled.
step "rust: shipped daemon, without test-support"
cargo clippy -p combined --all-targets --locked -- -D warnings
cargo test -p combined --locked --test shipped_build

# The app users install has no csp-probe: its default handler list and data-dir setup are otherwise
# never compiled (the steps above use --all-features), and no probe code may be in it.
step "rust: shipped app, without csp-probe"
cargo clippy -p combine-app --all-targets --locked -- -D warnings
cargo build -p combine-app --locked
if [ ! -f "$CARGO_TARGET_DIR/debug/combine-app" ]; then
  echo "verify: $CARGO_TARGET_DIR/debug/combine-app is missing; cannot check it for csp-probe code" >&2
  exit 1
fi
if grep -a -q -e COMBINE_CSP_PROBE_OUT -e COMBINE_CSP_PROBE_DATA "$CARGO_TARGET_DIR/debug/combine-app"; then
  echo "verify: the default combine-app build holds csp-probe code" >&2
  exit 1
fi

step "architecture: tools/arch-guard"
python3 -I -B tools/arch-guard/test_check.py
python3 -I -B tools/arch-guard/check.py

step "architecture: trellis rules check"
if command -v trellis >/dev/null 2>&1; then
  trellis rules check --format json >"${TMPDIR:-/tmp}/combine-trellis-$$.json"
  status=$?
  rm -f "${TMPDIR:-/tmp}/combine-trellis-$$.json"
  [ "$status" -eq 0 ] || exit "$status"
elif [ -n "${COMBINE_VERIFY_WITHOUT_TRELLIS:-}" ]; then
  echo "trellis not installed; skipped (COMBINE_VERIFY_WITHOUT_TRELLIS is set)"
else
  echo "verify: trellis is not on PATH; install it, or set COMBINE_VERIFY_WITHOUT_TRELLIS=1 where it can't run" >&2
  exit 1
fi

if [ -f app/web/package-lock.json ]; then
  step "frontend: npm ci, typecheck, tests"
  npm ci --prefix app/web --ignore-scripts
  npm run --prefix app/web check
fi

printf '\nverify: all checks passed\n'
